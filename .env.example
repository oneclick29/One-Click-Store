# Database
DATABASE_URL="postgresql://user:password@localhost:5432/one_click_store_dev"

# Authentication & JWT
JWT_SECRET="your-secure-jwt-secret-key-min-32-chars-generated"
JWT_EXPIRES_IN="7d"
SESSION_COOKIE_NAME="ocsession"
SESSION_COOKIE_SECURE="false"  # Set to true in production with HTTPS
SESSION_COOKIE_MAX_AGE="604800"  # 7 days in seconds

# Admin
ADMIN_EMAIL="admin@oneclickstore.local"

# Groq API (Chatbot)
GROQ_API_KEY="your-groq-api-key-here"
GROQ_MODEL="mixtral-8x7b-32768"

# Currency & Exchange Rates
PRIMARY_CURRENCY="PKR"
SUPPORTED_CURRENCIES="PKR,USD,SAR"
EXCHANGE_RATE_API_KEY=""  # Optional: for real-time rates

# Email (future integration)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL="noreply@oneclickstore.com"

# File Upload
UPLOAD_DIR="./public/uploads"
MAX_UPLOAD_SIZE_MB="10"

# App Configuration
NEXT_PUBLIC_APP_NAME="One Click Store"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SUPPORT_EMAIL="oneclickstore767@gmail.com"
NEXT_PUBLIC_CONTACT_PHONE="+92-xxx-xxxx"

# Analytics & Tracking
ENABLE_ANALYTICS="true"

# Rate Limiting
RATE_LIMIT_WINDOW_MS="900000"  # 15 minutes
RATE_LIMIT_MAX_REQUESTS="100"
RATE_LIMIT_AUTH_MAX_REQUESTS="5"  # Per 15 minutes for login/signup

# Node Environment
NODE_ENV="development"
